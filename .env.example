# ==============================================================================
# ATLAS APP CONFIGURATION TEMPLATE (.env.example)
#
# Copy to .env and pass it at build time:
#   flutter run --dart-define-from-file=.env
#
# Everything in this file is compiled INTO the app and can be read by anyone
# with the APK/IPA. Only put public, client-safe values here.
# NEVER commit your real .env file.
# ==============================================================================

# Supabase project (Project Settings > API). The anon key is public by design;
# Row Level Security protects the data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RevenueCat public SDK keys (Project settings > API keys). Client-safe.
REVENUECAT_ANDROID_KEY=goog_your_key_here
REVENUECAT_IOS_KEY=appl_your_key_here

# ------------------------------------------------------------------------------
# DO NOT put these in this file:
#
#   GEMINI_API_KEY            -> server secret for the ai-proxy Edge Function:
#                                supabase secrets set GEMINI_API_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY -> server only; injected into Edge Functions
#                                automatically. Never ship it in the app.
#
# Local development without Supabase: debug builds accept a developer key via
#   flutter run --dart-define=GEMINI_API_KEY=...
# Release builds ignore it.
# ------------------------------------------------------------------------------
